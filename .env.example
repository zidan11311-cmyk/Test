# Database
DATABASE_URL="postgresql://postgres:password@localhost:5432/hospital_db"

# NextAuth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="your-super-secret-key-change-in-production"

# WhatsApp Integration (Twilio or similar)
WHATSAPP_API_URL="https://api.twilio.com/2010-04-01"
WHATSAPP_ACCOUNT_SID="your-twilio-account-sid"
WHATSAPP_AUTH_TOKEN="your-twilio-auth-token"
WHATSAPP_FROM_NUMBER="whatsapp:+14155238886"

# Email (SMTP)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER="your-email@gmail.com"
SMTP_PASSWORD="your-app-password"
SMTP_FROM="noreply@hospital.com"

# App Settings
APP_NAME="MediCare Hospital"
APP_URL="http://localhost:3000"
APP_TIMEZONE="Africa/Lagos"

# File Upload
UPLOAD_MAX_SIZE="10485760" # 10MB in bytes
UPLOAD_DIR="./public/uploads"

# Encryption
ENCRYPTION_KEY="your-32-char-encryption-key-here"
