; Engine configuration file.
; It's best edited using the editor UI and not directly,
; but you can still edit it here if needed.

[configuration]

config_version=5

[application]

config/name="CoreBound"
config/features=PackedStringArray("4.3", "Mobile")
run/main_scene="res://scenes/main/Main.tscn"
config/icon="res://icon.svg"

[autoload]

GameManager="*res://autoloads/GameManager.gd"
WorldManager="*res://autoloads/WorldManager.gd"
SimulationManager="*res://autoloads/SimulationManager.gd"
PowerManager="*res://autoloads/PowerManager.gd"
InventoryManager="*res://autoloads/InventoryManager.gd"
CraftingManager="*res://autoloads/CraftingManager.gd"
SaveManager="*res://autoloads/SaveManager.gd"
AudioManager="*res://autoloads/AudioManager.gd"
InputManager="*res://autoloads/InputManager.gd"
SettingsManager="*res://autoloads/SettingsManager.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/size/mode=0
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation="landscape"

